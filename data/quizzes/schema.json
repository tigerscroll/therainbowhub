{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz translation",
  "type": "object",
  "required": ["title", "summary", "results", "stages"],
  "properties": {
    "title": { "type": "string" },
    "eyebrow": { "type": "string" },
    "summary": { "type": "string" },
    "landing": { "type": "object" },
    "about": { "type": "object" },
    "results": { "type": "object" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "questions"],
        "properties": {
          "title": { "type": "string" },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["question"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "context": { "type": "string", "minLength": 1 },
                "question": { "type": "string" },
                "presentation": {
                  "enum": ["text", "icons", "scale", "memory-cue", "sequence", "grid", "code", "spatial"]
                },
                "answers": {
                  "oneOf": [
                    { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                    { "type": "object", "minProperties": 2 }
                  ]
                },
                "icons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 2
                },
                "memoryItems": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 2
                },
                "continueLabel": { "type": "string" },
                "category": { "type": "string", "minLength": 1 },
                "delay": { "type": "integer", "minimum": 200, "maximum": 600 },
                "correct": { "type": "integer", "minimum": 0 },
                "reasoningSteps": { "type": "integer", "minimum": 1, "maximum": 4 },
                "visual": {
                  "type": "object",
                  "required": ["items", "ariaLabel"],
                  "properties": {
                    "items": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 9 },
                    "columns": { "type": "integer", "minimum": 1, "maximum": 8 },
                    "separator": { "type": "string" },
                    "ariaLabel": { "type": "string", "minLength": 1 }
                  }
                },
                "study": {
                  "type": "object",
                  "required": ["title", "items"],
                  "allOf": [
                    {
                      "if": {
                        "required": ["mode"],
                        "properties": { "mode": { "const": "automatic" } }
                      },
                      "else": { "required": ["continueLabel"] }
                    }
                  ],
                  "properties": {
                    "title": { "type": "string", "minLength": 1 },
                    "instruction": { "type": "string" },
                    "presentation": { "enum": ["text", "icons"] },
                    "items": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 2,
                      "maxItems": 8
                    },
                    "durationMs": { "type": "integer", "minimum": 1000, "maximum": 6000 },
                    "mode": { "enum": ["manual", "automatic"] },
                    "continueLabel": { "type": "string", "minLength": 1 },
                    "ariaLabel": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
