{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quiz translation",
  "type": "object",
  "required": ["title", "summary", "results", "stages"],
  "properties": {
    "title": { "type": "string" },
    "eyebrow": { "type": "string" },
    "summary": { "type": "string" },
    "landing": { "type": "object" },
    "about": { "type": "object" },
    "results": { "type": "object" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "questions"],
        "properties": {
          "title": { "type": "string" },
          "complete": { "type": "string" },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["question", "answers"],
              "properties": {
                "question": { "type": "string" },
                "answers": {
                  "oneOf": [
                    { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                    { "type": "object", "minProperties": 2 }
                  ]
                },
                "correct": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
